# KnowYourLoan Environment Configuration Example

# Administrator Security
# Default fallback: Admin@KYL2026
ADMIN_DEFAULT_PASSWORD=Admin@KYL2026

# Production Database URL (PostgreSQL / Supabase / Render)
# Leave unset or empty to use local SQLite (know_your_loan.db)
# Example Supabase pooled connection string:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Local SQLite Database Path override (Optional; defaults to know_your_loan.db)
# KYL_DB_PATH=know_your_loan.db

# Server Bindings (FastAPI)
HOST=127.0.0.1
PORT=8000

